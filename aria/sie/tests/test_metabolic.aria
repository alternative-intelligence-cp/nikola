// test_metabolic.aria — Self-test for nikola_metabolic_controller
use "nikola_metabolic_controller.aria".*;

func:failsafe = int32(tbb32:err_code) {
    println("FAIL: metabolic controller test hit failsafe");
    exit 1;
};

func:main = int32() {
    println("=== Nikola MetabolicController (Aria) ===");
    println("");

    // Initialize state
    flt64:atp = DEFAULT_MAX_ATP;
    flt64:cap = DEFAULT_MAX_ATP;
    flt64:threshold = DEFAULT_THRESHOLD;
    int64:cycles = 0i64;
    int64:naps = 0i64;

    // Check initial state
    int32:nap1 = raw needs_nap(atp, threshold);
    int32:afford1 = raw cycle_affordable(atp);
    println(`Initial ATP: &{atp}`);
    println(`Needs nap: &{nap1}  Affordable: &{afford1}`);

    // Print full state
    drop print_state(atp, cap, threshold, cycles, naps);
    println("");

    // Run 5 SIE cycles (750 each = 3750 consumed)
    println("Running 5 SIE cycles (750 ATP each)...");
    loop(0, 5, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 5 cycles: &{atp}`);

    // Run 5 more (total 7500 consumed, 2500 remaining)
    println("Running 5 more cycles...");
    loop(0, 5, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 10 cycles: &{atp}`);

    // Still above threshold (2500 > 2000)
    int32:nap2 = raw needs_nap(atp, threshold);
    println(`Needs nap at 2500: &{nap2} (expected 0)`);
    println("");

    // Run 3 more -> 2500 - 2250 = 250
    println("Running 3 more cycles...");
    loop(0, 3, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 13 cycles: &{atp}`);

    // Now below threshold (250 < 2000) — needs nap
    int32:nap3 = raw needs_nap(atp, threshold);
    println(`Needs nap at 250: &{nap3} (expected 1)`);

    // Should consolidate (250/10000 = 0.025 < 0.2)
    int32:consol = raw should_consolidate(atp, cap);
    println(`Should consolidate: &{consol} (expected 1)`);
    println("");

    // Recharge 5000 -> 250 + 5000 = 5250
    println("Recharging 5000 ATP...");
    atp = raw recharge(atp, 5000.0, cap);
    naps = (naps + 1i64);
    println(`ATP after recharge: &{atp}`);

    int32:nap4 = raw needs_nap(atp, threshold);
    println(`Needs nap: &{nap4} (expected 0)`);
    println("");

    // Final state
    drop print_state(atp, cap, threshold, cycles, naps);
    println("");

    // Edge cases
    println("Edge cases:");
    flt64:zeroed = raw consume(100.0, 999.0);
    println(`  consume(100, 999) = &{zeroed} (expected 0)`);

    flt64:capped = raw recharge(9500.0, 1000.0, 10000.0);
    println(`  recharge(9500, 1000, 10000) = &{capped} (expected 10000)`);

    int32:afford_zero = raw can_afford(0.0, 750.0);
    println(`  can_afford(0, 750) = &{afford_zero} (expected 0)`);

    int32:afford_exact = raw can_afford(750.0, 750.0);
    println(`  can_afford(750, 750) = &{afford_exact} (expected 1)`);

    flt64:ratio = raw floor_ratio(500.0, 10000.0);
    println(`  floor_ratio(500, 10000) = &{ratio} (expected 0.05)`);

    flt64:ratio_zero = raw floor_ratio(100.0, 0.0);
    println(`  floor_ratio(100, 0) = &{ratio_zero} (expected 0)`);

    println("");
    println("All MetabolicController tests passed.");
    exit 0;
};
