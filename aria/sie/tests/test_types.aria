// test_types.aria — Self-test for nikola_sie_types
use "nikola_sie_types.aria".*;

func:failsafe = int32(tbb32:err_code) {
    println("FAIL: SIE types test hit failsafe");
    exit 1;
};

func:main = int32() {
    println("=== Nikola SIE Types (Aria) ===");
    println("");

    // Test status codes
    println("Status codes:");
    int32:s = 0i32;
    loop(0, 7, 1) {
        string:sname = raw status_name(s);
        println(`  &{s} = &{sname}`);
        s = (s + 1i32);
    }
    println("");

    // Test CycleStats initialization
    int64:total = 0i64;
    int64:succeeded = 0i64;
    int64:atp_denied = 0i64;

    // Simulate 5 successful cycles
    loop(0, 5, 1) {
        total = raw increment_stat(total);
        succeeded = raw increment_stat(succeeded);
    }
    // Simulate 2 ATP denials
    loop(0, 2, 1) {
        total = raw increment_stat(total);
        atp_denied = raw increment_stat(atp_denied);
    }

    println("Cumulative stats after 7 cycles:");
    println(`  Total:        &{total}`);
    println(`  Succeeded:    &{succeeded}`);
    println(`  ATP denied:   &{atp_denied}`);
    println("");

    // Print a sample report
    drop print_report(STATUS_SUCCESS, 1i32, 1i32, 1i32, 1i32,
                      0.0000003, 0.0, 12.5, 750.0);

    println("");
    println("All SIE types verified.");
    exit 0;
};
