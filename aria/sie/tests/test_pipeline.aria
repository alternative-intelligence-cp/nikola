// test_pipeline.aria — Integration test for the full SIE pipeline
//
// Only import the pipeline module — it re-exports all gate + type symbols.
// Diamond imports (same module from multiple paths) crash ariac.
use "nikola_sie_pipeline.aria".*;

func:failsafe = int32(tbb32:err_code) {
    println("FAIL: pipeline test hit failsafe");
    exit 1;
};

func:main = int32() {
    println("=== Nikola SIE Pipeline Integration Test ===");
    println("");

    // Reset swapper state
    drop reset_swapper();

    // ── Test 1: Full successful cycle ─────────────────────────────
    println("Test 1: Full successful cycle");
    flt64:atp = 10000.0;
    flt64:threshold = 2000.0;
    int32:status1 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "int main() { return 0; }",
        1000.0, 1000.0000001, 0.0, 1.00001, 50.0,
        "/tmp/module_v1.so",
        atp, threshold
    );
    string:name1 = raw status_name(status1);
    println(`  Status: &{name1} (expected SUCCESS)`);
    atp = raw consume_cycle(atp);
    println(`  ATP: &{atp}`);
    println("");

    // ── Test 2: ATP denied (budget exhausted) ─────────────────────
    println("Test 2: ATP denied (low budget)");
    int32:status2 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "int main() { return 0; }",
        1000.0, 1000.0000001, 0.0, 1.00001, 50.0,
        "/tmp/module_v2.so",
        100.0, 2000.0
    );
    string:name2 = raw status_name(status2);
    println(`  Status: &{name2} (expected ATP_DENIED)`);
    println("");

    // ── Test 3: Gate 0 failure (bad signature) ────────────────────
    println("Test 3: Gate 0 failure (bad sig length)");
    int32:status3 = raw run_sie_cycle(
        "/tmp/module.so", 32i64, 32i64,
        "int main() { return 0; }",
        1000.0, 1000.0000001, 0.0, 1.00001, 50.0,
        "/tmp/module_v3.so",
        atp, threshold
    );
    string:name3 = raw status_name(status3);
    println(`  Status: &{name3} (expected SECURITY_REJECTED)`);
    println("");

    // ── Test 4: Gate 1 failure (banned pattern) ───────────────────
    println("Test 4: Gate 1 failure (system call)");
    int32:status4 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "system(\"rm -rf /\")",
        1000.0, 1000.0000001, 0.0, 1.00001, 50.0,
        "/tmp/module_v4.so",
        atp, threshold
    );
    string:name4 = raw status_name(status4);
    println(`  Status: &{name4} (expected SECURITY_REJECTED)`);
    println("");

    // ── Test 5: Gate 2 failure (energy violation) ─────────────────
    println("Test 5: Gate 2 failure (energy drift)");
    int32:status5 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "int main() { return 0; }",
        1000.0, 2000.0, 0.0, 1.00001, 50.0,
        "/tmp/module_v5.so",
        atp, threshold
    );
    string:name5 = raw status_name(status5);
    println(`  Status: &{name5} (expected PHYSICS_REJECTED)`);
    println("");

    // ── Test 6: Gate 2 failure (resonance attack) ─────────────────
    println("Test 6: Gate 2 failure (resonance)");
    int32:status6 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "int main() { return 0; }",
        1000.0, 1000.0000001, 0.0, 1.00001, 200.0,
        "/tmp/module_v6.so",
        atp, threshold
    );
    string:name6 = raw status_name(status6);
    println(`  Status: &{name6} (expected PHYSICS_REJECTED)`);
    println("");

    // ── Test 7: Gate 3 failure (bad .so path) ─────────────────────
    println("Test 7: Gate 3 failure (bad path)");
    int32:status7 = raw run_sie_cycle(
        "/tmp/module.so", 64i64, 32i64,
        "int main() { return 0; }",
        1000.0, 1000.0000001, 0.0, 1.00001, 50.0,
        "/tmp/bad_module.txt",
        atp, threshold
    );
    string:name7 = raw status_name(status7);
    println(`  Status: &{name7} (expected LOAD_FAILED)`);
    println("");

    // ── Test 8: Multi-cycle ATP drain ─────────────────────────────
    println("Test 8: Multi-cycle ATP drain");
    flt64:budget = 10000.0;
    int32:cycles_run = 0i32;
    drop reset_swapper();
    loop(0, 20, 1) {
        int32:affordable = raw cycle_affordable(budget);
        if (affordable == 1i32) {
            budget = raw consume_cycle(budget);
            cycles_run = (cycles_run + 1i32);
        }
    }
    println(`  Cycles run: &{cycles_run} (expected 13)`);
    println(`  Remaining ATP: &{budget}`);
    println("");

    // ── Test 9: Nap + recharge cycle ──────────────────────────────
    println("Test 9: Nap detection + recharge");
    int32:need_nap = raw needs_nap(budget, 2000.0);
    println(`  Needs nap at &{budget}: &{need_nap} (expected 1)`);
    budget = raw recharge(budget, 5000.0, 10000.0);
    int32:need_nap2 = raw needs_nap(budget, 2000.0);
    println(`  After recharge: &{budget}, needs_nap: &{need_nap2} (expected 0)`);
    println("");

    // ── Test 10: Cycle report output ──────────────────────────────
    println("Test 10: Cycle report formatting");
    drop print_cycle_result(1i32, STATUS_SUCCESS, 1i32, 1i32, 1i32, 1i32,
                            10000.0, 9250.0);
    println("");
    drop print_cycle_result(2i32, STATUS_SECURITY_REJECTED, 1i32, 0i32, 0i32, 0i32,
                            9250.0, 9250.0);
    println("");

    println("All SIE pipeline tests passed.");
    exit 0;
};
