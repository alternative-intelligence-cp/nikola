// nikola_metabolic_controller.aria — MetabolicController in Aria
//
// Ported from: nikola/src/autonomy/metabolic_controller.cpp
// Reference: nikola_full.txt §5.4, ConsolidationScheduler
// Purpose: ATP energy budget management for the SIE pipeline
// Contained: Changes here don't cascade into Nikola C++ code
//
// The MetabolicController enforces thermodynamic budgeting.
// Every SIE cycle costs ATP (compile 500 + verify 200 + deploy 50 = 750).
// If ATP drops below the nap threshold, the system must rest.
// All functions are pure: take state in, return new state out.

// -----------------------------------------------------------------------
// ATP Cost Constants (from evolutionary_orchestrator.hpp)
// -----------------------------------------------------------------------

fixed flt64:ATP_COMPILE_COST  = 500.0;
fixed flt64:ATP_VERIFY_COST   = 200.0;
fixed flt64:ATP_DEPLOY_COST   = 50.0;
fixed flt64:ATP_CYCLE_TOTAL   = 750.0;
fixed flt64:METABOLIC_FLOOR   = 0.2;
fixed flt64:DEFAULT_MAX_ATP   = 10000.0;
fixed flt64:DEFAULT_THRESHOLD = 2000.0;

// -----------------------------------------------------------------------
// needs_nap — 1 if ATP is below the nap threshold, 0 otherwise
// -----------------------------------------------------------------------

func:needs_nap = int32(flt64:atp, flt64:threshold) {
    if (atp < threshold) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// can_afford — 1 if ATP >= cost, 0 otherwise
// -----------------------------------------------------------------------

func:can_afford = int32(flt64:atp, flt64:cost) {
    if (atp >= cost) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// cycle_affordable — 1 if ATP >= full cycle cost (750)
// -----------------------------------------------------------------------

func:cycle_affordable = int32(flt64:atp) {
    if (atp >= ATP_CYCLE_TOTAL) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// consume — return new ATP after deducting cost (floors at 0.0)
// -----------------------------------------------------------------------

func:consume = flt64(flt64:atp, flt64:cost) {
    flt64:result = (atp - cost);
    if (result < 0.0) {
        pass 0.0;
    }
    pass result;
};

// -----------------------------------------------------------------------
// recharge — return new ATP after adding amount (caps at max_atp)
// -----------------------------------------------------------------------

func:recharge = flt64(flt64:atp, flt64:amount, flt64:cap) {
    flt64:result = (atp + amount);
    if (result > cap) {
        pass cap;
    }
    pass result;
};

// -----------------------------------------------------------------------
// consume_cycle — deduct full cycle cost (compile + verify + deploy)
// -----------------------------------------------------------------------

func:consume_cycle = flt64(flt64:atp) {
    flt64:result = (atp - ATP_CYCLE_TOTAL);
    if (result < 0.0) {
        pass 0.0;
    }
    pass result;
};

// -----------------------------------------------------------------------
// floor_ratio — ATP / max_atp ratio
// Caller compares result to METABOLIC_FLOOR (0.2)
// -----------------------------------------------------------------------

func:floor_ratio = flt64(flt64:atp, flt64:cap) {
    if (cap <= 0.0) {
        pass 0.0;
    }
    pass (atp / cap);
};

// -----------------------------------------------------------------------
// should_consolidate — from ConsolidationScheduler logic
// Returns 1 if ATP/max < METABOLIC_FLOOR (0.2)
// -----------------------------------------------------------------------

func:should_consolidate = int32(flt64:atp, flt64:cap) {
    flt64:ratio = (atp / cap);
    if (ratio < METABOLIC_FLOOR) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// print_state — format controller state for diagnostics
// -----------------------------------------------------------------------

func:print_state = NIL(flt64:atp, flt64:cap, flt64:threshold,
                       int64:cycles, int64:naps) {
    flt64:ratio = (atp / cap);
    int32:napping = 0i32;
    if (atp < threshold) {
        napping = 1i32;
    }
    println("=== MetabolicController State ===");
    println(`  ATP:          &{atp} / &{cap}`);
    println(`  Ratio:        &{ratio}`);
    println(`  Threshold:    &{threshold}`);
    println(`  Needs nap:    &{napping}`);
    println(`  Cycles done:  &{cycles}`);
    println(`  Naps taken:   &{naps}`);
    pass(NIL);
};

// -----------------------------------------------------------------------
// Test
// -----------------------------------------------------------------------

func:failsafe = int32(tbb32:err_code) {
    println("  Failsafe: metabolic controller module loaded");
    exit 1;
};

func:main = int32() {
    println("=== Nikola MetabolicController (Aria) ===");
    println("");

    // Initialize state
    flt64:atp = DEFAULT_MAX_ATP;
    flt64:cap = DEFAULT_MAX_ATP;
    flt64:threshold = DEFAULT_THRESHOLD;
    int64:cycles = 0i64;
    int64:naps = 0i64;

    // Check initial state
    int32:nap1 = raw needs_nap(atp, threshold);
    int32:afford1 = raw cycle_affordable(atp);
    println(`Initial ATP: &{atp}`);
    println(`Needs nap: &{nap1}  Affordable: &{afford1}`);

    // Print full state
    drop print_state(atp, cap, threshold, cycles, naps);
    println("");

    // Run 5 SIE cycles (750 each = 3750 consumed)
    println("Running 5 SIE cycles (750 ATP each)...");
    loop(0, 5, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 5 cycles: &{atp}`);

    // Run 5 more (total 7500 consumed, 2500 remaining)
    println("Running 5 more cycles...");
    loop(0, 5, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 10 cycles: &{atp}`);

    // Still above threshold (2500 > 2000)
    int32:nap2 = raw needs_nap(atp, threshold);
    println(`Needs nap at 2500: &{nap2} (expected 0)`);
    println("");

    // Run 3 more → 2500 - 2250 = 250
    println("Running 3 more cycles...");
    loop(0, 3, 1) {
        atp = raw consume_cycle(atp);
        cycles = (cycles + 1i64);
    }
    println(`ATP after 13 cycles: &{atp}`);

    // Now below threshold (250 < 2000) — needs nap
    int32:nap3 = raw needs_nap(atp, threshold);
    println(`Needs nap at 250: &{nap3} (expected 1)`);

    // Should consolidate (250/10000 = 0.025 < 0.2)
    int32:consol = raw should_consolidate(atp, cap);
    println(`Should consolidate: &{consol} (expected 1)`);
    println("");

    // Recharge 5000 → 250 + 5000 = 5250
    println("Recharging 5000 ATP...");
    atp = raw recharge(atp, 5000.0, cap);
    naps = (naps + 1i64);
    println(`ATP after recharge: &{atp}`);

    int32:nap4 = raw needs_nap(atp, threshold);
    println(`Needs nap: &{nap4} (expected 0)`);
    println("");

    // Final state
    drop print_state(atp, cap, threshold, cycles, naps);
    println("");

    // Edge cases
    println("Edge cases:");
    flt64:zeroed = raw consume(100.0, 999.0);
    println(`  consume(100, 999) = &{zeroed} (expected 0)`);

    flt64:capped = raw recharge(9500.0, 1000.0, 10000.0);
    println(`  recharge(9500, 1000, 10000) = &{capped} (expected 10000)`);

    int32:afford_zero = raw can_afford(0.0, 750.0);
    println(`  can_afford(0, 750) = &{afford_zero} (expected 0)`);

    int32:afford_exact = raw can_afford(750.0, 750.0);
    println(`  can_afford(750, 750) = &{afford_exact} (expected 1)`);

    flt64:ratio = raw floor_ratio(500.0, 10000.0);
    println(`  floor_ratio(500, 10000) = &{ratio} (expected 0.05)`);

    flt64:ratio_zero = raw floor_ratio(100.0, 0.0);
    println(`  floor_ratio(100, 0) = &{ratio_zero} (expected 0)`);

    println("");
    println("All MetabolicController tests passed.");
    exit 0;
};
