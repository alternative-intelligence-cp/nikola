// nikola_metabolic_controller.aria — MetabolicController in Aria
//
// Ported from: nikola/src/autonomy/metabolic_controller.cpp
// Reference: nikola_full.txt §5.4, ConsolidationScheduler
// Purpose: ATP energy budget management for the SIE pipeline
// Contained: Changes here don't cascade into Nikola C++ code
//
// The MetabolicController enforces thermodynamic budgeting.
// Every SIE cycle costs ATP (compile 500 + verify 200 + deploy 50 = 750).
// If ATP drops below the nap threshold, the system must rest.
// All functions are pure: take state in, return new state out.

// -----------------------------------------------------------------------
// ATP Cost Constants (from evolutionary_orchestrator.hpp)
// -----------------------------------------------------------------------

fixed flt64:ATP_COMPILE_COST  = 500.0;
fixed flt64:ATP_VERIFY_COST   = 200.0;
fixed flt64:ATP_DEPLOY_COST   = 50.0;
fixed flt64:ATP_CYCLE_TOTAL   = 750.0;
fixed flt64:METABOLIC_FLOOR   = 0.2;
fixed flt64:DEFAULT_MAX_ATP   = 10000.0;
fixed flt64:DEFAULT_THRESHOLD = 2000.0;

// -----------------------------------------------------------------------
// needs_nap — 1 if ATP is below the nap threshold, 0 otherwise
// -----------------------------------------------------------------------

func:needs_nap = int32(flt64:atp, flt64:threshold) {
    if (atp < threshold) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// can_afford — 1 if ATP >= cost, 0 otherwise
// -----------------------------------------------------------------------

func:can_afford = int32(flt64:atp, flt64:cost) {
    if (atp >= cost) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// cycle_affordable — 1 if ATP >= full cycle cost (750)
// -----------------------------------------------------------------------

func:cycle_affordable = int32(flt64:atp) {
    if (atp >= ATP_CYCLE_TOTAL) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// consume — return new ATP after deducting cost (floors at 0.0)
// -----------------------------------------------------------------------

func:consume = flt64(flt64:atp, flt64:cost) {
    flt64:result = (atp - cost);
    if (result < 0.0) {
        pass 0.0;
    }
    pass result;
};

// -----------------------------------------------------------------------
// recharge — return new ATP after adding amount (caps at max_atp)
// -----------------------------------------------------------------------

func:recharge = flt64(flt64:atp, flt64:amount, flt64:cap) {
    flt64:result = (atp + amount);
    if (result > cap) {
        pass cap;
    }
    pass result;
};

// -----------------------------------------------------------------------
// consume_cycle — deduct full cycle cost (compile + verify + deploy)
// -----------------------------------------------------------------------

func:consume_cycle = flt64(flt64:atp) {
    flt64:result = (atp - ATP_CYCLE_TOTAL);
    if (result < 0.0) {
        pass 0.0;
    }
    pass result;
};

// -----------------------------------------------------------------------
// floor_ratio — ATP / max_atp ratio
// Caller compares result to METABOLIC_FLOOR (0.2)
// -----------------------------------------------------------------------

func:floor_ratio = flt64(flt64:atp, flt64:cap) {
    if (cap <= 0.0) {
        pass 0.0;
    }
    pass (atp / cap);
};

// -----------------------------------------------------------------------
// should_consolidate — from ConsolidationScheduler logic
// Returns 1 if ATP/max < METABOLIC_FLOOR (0.2)
// -----------------------------------------------------------------------

func:should_consolidate = int32(flt64:atp, flt64:cap) {
    flt64:ratio = (atp / cap);
    if (ratio < METABOLIC_FLOOR) {
        pass 1i32;
    }
    pass 0i32;
};

// -----------------------------------------------------------------------
// print_state — format controller state for diagnostics
// -----------------------------------------------------------------------

func:print_state = NIL(flt64:atp, flt64:cap, flt64:threshold,
                       int64:cycles, int64:naps) {
    flt64:ratio = (atp / cap);
    int32:napping = 0i32;
    if (atp < threshold) {
        napping = 1i32;
    }
    println("=== MetabolicController State ===");
    println(`  ATP:          &{atp} / &{cap}`);
    println(`  Ratio:        &{ratio}`);
    println(`  Threshold:    &{threshold}`);
    println(`  Needs nap:    &{napping}`);
    println(`  Cycles done:  &{cycles}`);
    println(`  Naps taken:   &{naps}`);
    pass(NIL);
};

// Library module — no main/failsafe. Tests in tests/test_metabolic.aria
