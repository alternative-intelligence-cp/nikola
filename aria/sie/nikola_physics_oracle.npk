// nikola_physics_oracle.aria — Physics Oracle Checks in Aria
//
// Ported from: nikola/include/nikola/physics/physics_oracle.hpp
// Reference: nikola_full.txt §5.4 (SIE), GAP-030 (calibration spec)
// Purpose: Stateless physics validation for SIE candidate code
// Contained: Changes here don't cascade into Nikola C++ code
//
// The Physics Oracle validates that candidate code preserves
// the fundamental physical invariants of the UFIE simulation:
//   1. Energy conservation (Hamiltonian check)
//   2. Symplectic structure (reversibility / Liouville check)
//   3. Numerical viscosity (damping accuracy check)
//
// All functions are pure and stateless — no side effects,
// no heap allocation, no FFI. Just math.

// -----------------------------------------------------------------------
// Oracle Tolerance Constants
// From physics_oracle.hpp and GAP-030 calibration spec
// -----------------------------------------------------------------------

fixed flt64:CANDLE_DRIFT_LIMIT   = 0.000001;          // 1e-6  standard candle
fixed flt64:LONGRUN_DRIFT_LIMIT  = 0.00001;           // 1e-5  long-run (1M steps)
fixed flt64:REVERSIBILITY_LIMIT  = 0.000000000001;    // 1e-12 symplectic check
fixed flt64:VISCOSITY_LIMIT      = 0.0001;            // 1e-4  damping accuracy

// SCRAM protocol thresholds
fixed int32:SCRAM_MAX_ATTEMPTS   = 3i32;
fixed flt64:SCRAM_RESET_SECONDS  = 60.0;

// Verdict codes
fixed int32:ORACLE_PASS           = 0i32;
fixed int32:ORACLE_FAIL_ENERGY    = 1i32;
fixed int32:ORACLE_FAIL_REVERSE   = 2i32;
fixed int32:ORACLE_FAIL_VISCOSITY = 3i32;
fixed int32:ORACLE_SCRAM          = 4i32;

// -----------------------------------------------------------------------
// abs_flt64 — absolute value (no stdlib math dependency)
// -----------------------------------------------------------------------

func:abs_flt64 = flt64(flt64:val) {
    if (val < 0.0) {
        pass (0.0 - val);
    }
    pass val;
};

// -----------------------------------------------------------------------
// compute_energy_drift — |H_final - H_initial| / |H_initial|
// Returns the relative drift as a positive flt64.
// If H_initial is near zero, returns the absolute difference.
// -----------------------------------------------------------------------

func:compute_energy_drift = flt64(flt64:h_initial, flt64:h_final) {
    flt64:diff = raw abs_flt64(h_final - h_initial);
    flt64:denom = raw abs_flt64(h_initial);
    if (denom < 0.000000000001) {
        // Avoid division by near-zero; return absolute diff
        pass diff;
    }
    pass (diff / denom);
};

// -----------------------------------------------------------------------
// check_energy — Standard Candle energy conservation test
// Returns ORACLE_PASS (0) or ORACLE_FAIL_ENERGY (1)
// -----------------------------------------------------------------------

func:check_energy = int32(flt64:h_initial, flt64:h_final, flt64:tolerance) {
    flt64:drift = raw compute_energy_drift(h_initial, h_final);
    if (drift < tolerance) {
        pass ORACLE_PASS;
    }
    pass ORACLE_FAIL_ENERGY;
};

// -----------------------------------------------------------------------
// check_reversibility — Symplectic / Liouville check
// Takes the L2 squared norm of forward-backward state difference
// Returns ORACLE_PASS (0) or ORACLE_FAIL_REVERSE (2)
// -----------------------------------------------------------------------

func:check_reversibility = int32(flt64:rev_error, flt64:tolerance) {
    if (rev_error < tolerance) {
        pass ORACLE_PASS;
    }
    pass ORACLE_FAIL_REVERSE;
};

// -----------------------------------------------------------------------
// check_viscosity — Damping accuracy check
// observed_ratio = E(t) / E_theory(t), should be ~1.0
// Returns ORACLE_PASS (0) or ORACLE_FAIL_VISCOSITY (3)
// -----------------------------------------------------------------------

func:check_viscosity = int32(flt64:observed_ratio, flt64:tolerance) {
    flt64:deviation = raw abs_flt64(observed_ratio - 1.0);
    if (deviation < tolerance) {
        pass ORACLE_PASS;
    }
    pass ORACLE_FAIL_VISCOSITY;
};

// -----------------------------------------------------------------------
// run_full_oracle — run all three checks in order
// Returns first failure code or ORACLE_PASS if all clear
// -----------------------------------------------------------------------

func:run_full_oracle = int32(flt64:h_initial, flt64:h_final,
                             flt64:rev_error, flt64:viscosity_ratio,
                             int32:skip_oracle) {
    // Optional bypass for testing
    if (skip_oracle == 1i32) {
        pass ORACLE_PASS;
    }

    // Gate 1: Energy conservation (standard candle tolerance)
    int32:energy_result = raw check_energy(h_initial, h_final, CANDLE_DRIFT_LIMIT);
    if (energy_result > 0i32) {
        pass energy_result;
    }

    // Gate 2: Reversibility (symplectic structure)
    int32:rev_result = raw check_reversibility(rev_error, REVERSIBILITY_LIMIT);
    if (rev_result > 0i32) {
        pass rev_result;
    }

    // Gate 3: Viscosity (damping accuracy)
    int32:visc_result = raw check_viscosity(viscosity_ratio, VISCOSITY_LIMIT);
    if (visc_result > 0i32) {
        pass visc_result;
    }

    pass ORACLE_PASS;
};

// -----------------------------------------------------------------------
// verdict_name — convert verdict code to human-readable string
// -----------------------------------------------------------------------

func:verdict_name = string(int32:verdict) {
    if (verdict == 0i32) {
        pass "PASS";
    }
    if (verdict == 1i32) {
        pass "FAIL_ENERGY";
    }
    if (verdict == 2i32) {
        pass "FAIL_REVERSE";
    }
    if (verdict == 3i32) {
        pass "FAIL_VISCOSITY";
    }
    if (verdict == 4i32) {
        pass "SCRAM";
    }
    pass "UNKNOWN";
};

// -----------------------------------------------------------------------
// print_verdict — format oracle result for diagnostics
// -----------------------------------------------------------------------

func:print_verdict = NIL(int32:verdict, flt64:drift, flt64:rev_err,
                         flt64:visc_ratio) {
    string:vname = raw verdict_name(verdict);
    println("=== Physics Oracle Verdict ===");
    println(`  Result:        &{vname}`);
    println(`  Energy drift:  &{drift}`);
    println(`  Reversibility: &{rev_err}`);
    println(`  Viscosity:     &{visc_ratio}`);
    pass(NIL);
};

// Library module — no main/failsafe. Tests in tests/test_oracle.aria

// -----------------------------------------------------------------------
// FFI-backed extended checks (from C shim, mirrors C++ PhysicsOracle)
// These call into libnikola_sie for validation parity with C++ pipeline.
// Link with -L shim -lnikola_sie -lm
// -----------------------------------------------------------------------

extern func:nk_oracle_check_energy = int32(flt64:h_initial, flt64:h_final, flt64:tolerance);
extern func:nk_oracle_energy_drift = flt64(flt64:h_initial, flt64:h_final);
extern func:nk_oracle_check_viscosity = int32(flt64:e_actual, flt64:e_0, flt64:alpha, flt64:t, flt64:tolerance);
extern func:nk_oracle_viscosity_error = flt64(flt64:e_actual, flt64:e_0, flt64:alpha, flt64:t);
extern func:nk_oracle_check_resonance = int32(flt64:psi_max, flt64:amplitude_limit);
extern func:nk_oracle_drift_alert = int32(flt64:drift_rate);
extern func:nk_oracle_is_decoherent = int32(flt64:visibility);

// -----------------------------------------------------------------------
// Resonance Attack check (new for v0.0.10)
// Returns ORACLE_PASS if psi_max < limit, else ORACLE_FAIL_ENERGY (reused)
// -----------------------------------------------------------------------

fixed flt64:RESONANCE_AMPLITUDE_LIMIT = 100.0;

func:check_resonance = int32(flt64:psi_max) {
    int32:safe = nk_oracle_check_resonance(psi_max, RESONANCE_AMPLITUDE_LIMIT);
    if (safe == 1i32) {
        pass ORACLE_PASS;
    }
    pass ORACLE_SCRAM;
};

// -----------------------------------------------------------------------
// Viscosity Trap via FFI (exponential decay model)
// E_theory = E_0 * exp(-alpha * t)
// -----------------------------------------------------------------------

func:check_viscosity_trap = int32(flt64:e_actual, flt64:e_0,
                                  flt64:alpha, flt64:t) {
    int32:safe = nk_oracle_check_viscosity(e_actual, e_0, alpha, t, VISCOSITY_LIMIT);
    if (safe == 1i32) {
        pass ORACLE_PASS;
    }
    pass ORACLE_FAIL_VISCOSITY;
};

// -----------------------------------------------------------------------
// Drift rate alert level: 0=OK, 1=WARN, 2=CRITICAL
// -----------------------------------------------------------------------

func:drift_alert_level = int32(flt64:drift_rate) {
    int32:level = nk_oracle_drift_alert(drift_rate);
    pass level;
};

// -----------------------------------------------------------------------
// Decoherence check — 1 if visibility < 0.01 (field lost coherence)
// -----------------------------------------------------------------------

func:check_decoherence = int32(flt64:visibility) {
    int32:lost = nk_oracle_is_decoherent(visibility);
    pass lost;
};

// -----------------------------------------------------------------------
// run_gate2 — full Gate 2 pipeline check
// Runs energy + reversibility + viscosity + resonance in order.
// Returns STATUS_SUCCESS or STATUS_PHYSICS_REJECTED
// -----------------------------------------------------------------------

fixed int32:STATUS_SUCCESS_G2         = 0i32;
fixed int32:STATUS_PHYSICS_REJECTED_G2 = 3i32;

func:run_gate2 = int32(flt64:h_initial, flt64:h_final,
                       flt64:rev_error, flt64:viscosity_ratio,
                       flt64:psi_max) {
    // Energy conservation
    int32:e = raw check_energy(h_initial, h_final, CANDLE_DRIFT_LIMIT);
    if (e > 0i32) {
        pass STATUS_PHYSICS_REJECTED_G2;
    }
    // Reversibility
    int32:r = raw check_reversibility(rev_error, REVERSIBILITY_LIMIT);
    if (r > 0i32) {
        pass STATUS_PHYSICS_REJECTED_G2;
    }
    // Viscosity
    int32:v = raw check_viscosity(viscosity_ratio, VISCOSITY_LIMIT);
    if (v > 0i32) {
        pass STATUS_PHYSICS_REJECTED_G2;
    }
    // Resonance attack
    int32:res = raw check_resonance(psi_max);
    if (res > 0i32) {
        pass STATUS_PHYSICS_REJECTED_G2;
    }
    pass STATUS_SUCCESS_G2;
};
